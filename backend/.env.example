DATABASE_URL=postgresql+asyncpg://jobos:jobos123@localhost:5432/jobos
GROQ_API_KEY=
GROQ_MODEL=groq/llama-3.3-70b-versatile
XAI_API_KEY=
XAI_MODEL=grok-4-fast
# Required in production: the app refuses to start without a strong value.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# For local development only, set DEBUG=true instead to use an insecure built-in key.
SECRET_KEY=
DEBUG=false
# Comma-separated emails whose existing passwordless profile (e.g. seeded demo
# data) may be claimed by signing up. Leave empty unless you are claiming one.
CLAIMABLE_EMAILS=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Gmail OAuth — see DEPLOY.md for how to create these in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/callback
FRONTEND_URL=http://localhost:5173
